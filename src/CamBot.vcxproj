  <Target Name="FetchFFmpeg" BeforeTargets="PrepareForBuild">
    <!-- Downloads/unpacks the pinned, NVENC-capable prebuilt FFmpeg into third_party\ffmpeg
         if it is not already there (see tools\fetch_ffmpeg.ps1); cheap no-op on every
         build after the first, so a fresh clone of this repo just builds, no MSYS2 needed. -->
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\tools\fetch_ffmpeg.ps1&quot;" />
  </Target>
  <Target Name="CopyFFmpegDlls" AfterTargets="Build">
    <!-- FFmpeg is linked as shared libs now (see LibraryPath above), so the DLLs have to
         land next to CamBot.exe or it won't start. -->
    <ItemGroup>
      <FFmpegDlls Include="$(ProjectDir)..\third_party\ffmpeg\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(FFmpegDlls)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
